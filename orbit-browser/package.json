{
  "name": "orbit-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && electron-builder --mac --dir",
    "build:code": "tsc --noEmit && vite build",
    "dist": "npm run build:code && electron-builder --mac dmg",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src electron tests vite.config.ts tsconfig.json package.json README.md",
    "test:integration": "npm run build:code && ORBIT_SMOKE=1 electron ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.orbit.browser",
    "productName": "ORBIT",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "identity": null
    },
    "directories": {
      "output": "release"
    }
  },
  "description": "ORBIT — Explora sin límites. Navegador de escritorio con WebContentsView.",
  "author": "ORBIT"
}
